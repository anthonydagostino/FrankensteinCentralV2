# Always-on monitor for the glance view, on a headless box with the HDMI plugged in.
# A plain X server (Xorg, started by xinit) with Chrome in kiosk mode on top: the oldest and most tested kiosk stack
# on Linux. The browser is started by /usr/local/bin/frankenstein-kiosk-session, written by deploy/kiosk/install.sh.
[Unit]
Description=FrankensteinCentral glance monitor
# tty1 is the terminal the monitor shows after boot; this takes it over in place of the text login prompt
Conflicts=getty@tty1.service
After=getty@tty1.service systemd-user-sessions.service network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__KIOSK_USER__
PAMName=login
UtmpIdentifier=tty1
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/__KIOSK_USER__
Environment=KIOSK_URL=__URL__
# Chrome moves itself into its own systemd scope under the user session, outside this unit's control group, so a
# restart does not kill it; the next Chrome then finds the profile lock, hands its URL to the orphan and exits 0.
# Kill any leftover and drop the lock before each start, and again on stop.
ExecStartPre=-/usr/bin/pkill -u __KIOSK_USER__ -f chrome
ExecStartPre=-/bin/rm -f /home/__KIOSK_USER__/.frankenstein-kiosk/SingletonLock /home/__KIOSK_USER__/.frankenstein-kiosk/SingletonSocket /home/__KIOSK_USER__/.frankenstein-kiosk/SingletonCookie
# the dashboard hides the pointer itself after five idle seconds; -keeptty keeps X on the tty systemd handed it;
# -nolisten tcp keeps X off the network
ExecStart=/usr/bin/xinit /usr/local/bin/frankenstein-kiosk-session -- /usr/bin/X :0 vt1 -nolisten tcp -keeptty
ExecStopPost=-/usr/bin/pkill -u __KIOSK_USER__ -f chrome
Restart=always
RestartSec=5
# a daily restart picks up new builds (the cookie lives in the profile directory, so no sign-in is needed)
RuntimeMaxSec=1d

[Install]
WantedBy=graphical.target
