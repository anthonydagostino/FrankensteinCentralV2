# Turns the monitor off for the night. Fired by frankenstein-kiosk-sleep.timer; the session script does the same
# at start when the service comes up inside the sleep window. Any input wakes the screen, and then DPMS turns it
# back off after a minute until the wake timer runs.
[Unit]
Description=FrankensteinCentral monitor off for the night
After=frankenstein-kiosk.service

[Service]
Type=oneshot
User=__KIOSK_USER__
Environment=DISPLAY=:0
ExecStart=/usr/local/bin/frankenstein-kiosk-screen off
